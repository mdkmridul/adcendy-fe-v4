{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.14.x",
    "npm": "10.9.x"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev",
    "dev:mock": "cross-env APP_ENV=local DATA_SOURCE=mock next dev",
    "dev:real": "cross-env APP_ENV=local DATA_SOURCE=real next dev",
    "build": "next build",
    "build:production": "cross-env NODE_ENV=production next build",
    "start": "next start",
    "start:production": "cross-env NODE_ENV=production next start",
    "test": "node --test --experimental-strip-types --experimental-specifier-resolution=node \"tests/**/*.test.ts\" \"tests/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "lint": "eslint . --max-warnings=0",
    "lint:baseline:prune": "eslint . --prune-suppressions --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "typecheck:wave1": "tsc --project tsconfig.wave1.json",
    "typecheck:wave2": "tsc --project tsconfig.wave2.json",
    "typecheck:wave3": "tsc --project tsconfig.wave3.json",
    "gen:api": "node scripts/generate-api-types.mjs",
    "gen:api:files": "node scripts/generate-api-types.mjs contracts/backend/files-v1/1.0.0/adcendy-files.openapi.json src/generated/files-v1.ts",
    "gen:api:check": "node scripts/check-generated-contract.mjs",
    "env:check": "node --experimental-strip-types scripts/validate-runtime-config.ts",
    "bundle:scan": "node scripts/scan-browser-bundle.mjs",
    "sbom:generate": "node scripts/generate-production-sbom.mjs",
    "proxy:verify": "node scripts/verify-proxy-reference.mjs",
    "promotion:verify": "node scripts/verify-image-promotion.mjs",
    "toolchain:check": "node scripts/verify-toolchain.mjs"
  },
  "dependencies": {
