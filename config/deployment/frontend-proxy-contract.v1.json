{
  "contractVersion": "1.0.0",
  "deploymentModel": "same-origin-reverse-proxy",
  "backendRevision": "working-tree@79324473cab50871875fc8c7472c440125b277a9",
  "backendOpenApiVersion": "2.3.0",
  "backendOpenApiSha256": "7caaad0010324eaf2dc12dee8c5975c117a852eb07bf0d471bad2dc42158d8fe",
  "externalRoutes": [
    {
      "path": "/v1/*",
      "upstream": "backend",
      "upstreamPath": "unchanged"
    },
    {
      "path": "/api/v2/*",
      "upstream": "backend",
      "upstreamPath": "unchanged"
    },
    {
      "path": "/*",
      "upstream": "frontend",
      "upstreamPath": "unchanged"
    }
  ],
  "privateRoutes": [
    "/v1/health/live",
    "/v1/health/ready"
  ],
  "requestPreservation": {
    "method": true,
    "query": true,
    "body": true,
    "authorization": true,
    "cookie": true,
    "origin": true,
    "referer": true,
    "idempotencyKey": true,
    "requestId": true,
    "automaticMutationRetries": false
  },
  "responsePreservation": {
    "status": true,
    "body": true,
    "headers": [
      "Set-Cookie",
      "Retry-After",
      "X-Request-Id",
      "Content-Type",
      "Content-Disposition",
      "Cache-Control",
      "Location"
    ],
    "streaming": true
  },
  "forwardedHeaders": {
    "acceptedByBackend": [
      "X-Forwarded-Proto",
      "X-Forwarded-Host",
      "X-Forwarded-For"
    ],
    "rejectedByBackend": [
      "Forwarded"
    ],
    "ingressMustStripClientSuppliedValues": true,
    "ingressMustSetAuthoritativeValues": true,
    "clientIpSource": "CF-Connecting-IP",
    "trustedBackendHops": 1
  },
  "environments": {
    "uat": {
      "publicOrigin": "https://uat.adcendy.com",
      "forwardedHost": "uat.adcendy.com",
      "forwardedProto": "https",
      "cors": "disabled"
    },
    "production": {
      "publicOrigin": "https://app.adcendy.com",
      "forwardedHost": "app.adcendy.com",
      "forwardedProto": "https",
      "cors": "disabled"
    },
    "local": {
      "origins": [
        "https://adcendy.localhost"
      ],
      "authoritativeOrigin": "https://adcendy.localhost",
      "httpFallback": null,
      "cors": "credentialed-exact-origin"
    }
  },
  "cache": {
    "apiResponses": "preserve-backend-no-store",
    "runtimeConfig": "no-store",
    "sharedProxyCachingAuthenticatedResponses": false
  },
  "runtimeConfig": {
    "path": "/runtime-config.js",
    "upstream": "frontend",
    "cacheControl": "no-store"
  },
  "source": {
    "backendContractPath": "config/deployment/frontend-proxy-contract.v1.json",
    "frontendContractPath": "config/deployment/frontend-proxy-contract.v1.json"
  }
}
