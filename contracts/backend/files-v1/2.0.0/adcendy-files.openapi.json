{
  "openapi": "3.0.3",
  "info": {
    "title": "Adcendy Campaign Files API",
    "version": "2.0.0",
    "description": "Derived V1 route slice for campaign documents used by the Frontend File Hub. The combined V1 + V2 contract is authoritative."
  },
  "x-adcendy-authoritative-contract": false,
  "x-adcendy-derived-from": "docs/openapi/v2/adcendy-api.openapi.json (combined V1 + V2 contract)",
  "servers": [
    {
      "url": "/",
      "description": "Same-origin reverse-proxy route"
    }
  ],
  "tags": [
    {
      "name": "Campaign files",
      "description": "Documents are uploaded or generated campaign files, including complete-kit PDFs."
    }
  ],
  "paths": {
    "/v1/campaigns/{campaignId}/documents": {
      "get": {
        "tags": [
          "Campaign files"
        ],
        "operationId": "listCampaignDocuments",
        "summary": "List campaign documents",
        "description": "Client File Hub operation. Clients see only their owned campaign and documents whose availableAt time has arrived. Admins may list any campaign.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-allowed-roles": [
          "CLIENT",
          "ADMIN"
        ],
        "x-error-codes": [
          "AUTHENTICATION_REQUIRED",
          "DOWNLOAD_NOT_PERMITTED",
          "CAMPAIGN_NOT_FOUND"
        ],
        "parameters": [
          {
            "name": "campaignId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated document list.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentListEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication is required.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The authenticated actor is not permitted.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "The campaign or requested resource was not found.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Campaign files"
        ],
        "operationId": "uploadCampaignDocument",
        "summary": "Upload or replace a campaign document",
        "description": "Administrative publishing operation. An assigned reviewer may upload only to the assigned campaign. The normal client UI does not upload files through this route.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-allowed-roles": [
          "ADMIN",
          "REVIEWER"
        ],
        "x-error-codes": [
          "AUTHENTICATION_REQUIRED",
          "UPLOAD_NOT_PERMITTED",
          "CAMPAIGN_NOT_FOUND",
          "FILE_MISSING",
          "FILE_TOO_LARGE",
          "UNSUPPORTED_FILE_TYPE",
          "VALIDATION_ERROR",
          "STORAGE_UNAVAILABLE"
        ],
        "parameters": [
          {
            "name": "campaignId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/DocumentUploadRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Document uploaded.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "The file part is missing or metadata is invalid.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication is required.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The authenticated actor is not permitted.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "The campaign or requested resource was not found.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "The file exceeds the 25 MiB limit.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "415": {
            "description": "The file content type is unsupported.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Object storage is temporarily unavailable.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/campaigns/{campaignId}/documents/{documentId}/download": {
      "get": {
        "tags": [
          "Campaign files"
        ],
        "operationId": "getCampaignDocumentDownload",
        "summary": "Get a document download URL",
        "description": "Client File Hub operation. The URL is short-lived and must not be cached or reused after its expiresAt value.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-allowed-roles": [
          "CLIENT",
          "ADMIN"
        ],
        "x-error-codes": [
          "AUTHENTICATION_REQUIRED",
          "DOWNLOAD_NOT_PERMITTED",
          "CAMPAIGN_NOT_FOUND",
          "DOCUMENT_NOT_FOUND",
          "FILE_MISSING",
          "DOCUMENT_NOT_AVAILABLE",
          "SIGNED_URL_GENERATION_FAILED"
        ],
        "parameters": [
          {
            "name": "campaignId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "documentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Download authorization and signed URL.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentDownloadEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication is required.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "The authenticated actor is not permitted.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "The campaign or requested resource was not found.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "The document is not yet available.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "The signed URL could not be generated.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "headers": {
      "RequestId": {
        "description": "Request correlation identifier.",
        "schema": {
          "type": "string"
        }
      },
      "CacheControl": {
        "description": "Response caching policy. Signed URL responses are expected to be no-store.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "ResponseMeta": {
        "type": "object",
        "required": [
          "requestId",
          "timestamp"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "nullable": true
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statusCode",
          "errorCode",
          "message",
          "details",
          "requestId"
        ],
        "properties": {
          "statusCode": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "errorCode": {
            "type": "string",
            "enum": [
              "FILE_TOO_LARGE",
              "UNSUPPORTED_FILE_TYPE",
              "FILE_MISSING",
              "CAMPAIGN_NOT_FOUND",
              "DOCUMENT_NOT_FOUND",
              "UPLOAD_NOT_PERMITTED",
              "DOWNLOAD_NOT_PERMITTED",
              "DOCUMENT_NOT_AVAILABLE",
              "STORAGE_UNAVAILABLE",
              "SIGNED_URL_GENERATION_FAILED",
              "AUTHENTICATION_REQUIRED",
              "VALIDATION_ERROR",
              "FORBIDDEN",
              "RATE_LIMITED",
              "INTERNAL_ERROR"
            ]
          },
          "message": {
            "type": "string"
          },
          "details": {
            "nullable": true
          },
          "requestId": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page",
          "pageSize",
          "total",
          "hasNext"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "hasNext": {
            "type": "boolean"
          }
        }
      },
      "Document": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentId",
          "campaignId",
          "title",
          "description",
          "fileName",
          "fileSizeBytes",
          "contentType",
          "availableAt",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "documentId": {
            "type": "string"
          },
          "campaignId": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "fileName": {
            "type": "string"
          },
          "fileSizeBytes": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          },
          "contentType": {
            "type": "string"
          },
          "availableAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DocumentList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "meta"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Document"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMeta"
          }
        }
      },
      "DocumentUploadRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "description": "Maximum 25 MiB. Supported: PDF, Word, Excel, PowerPoint, CSV, text, Markdown, JPEG, and PNG."
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "availableAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DocumentDownload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentId",
          "downloadUrl",
          "expiresAt",
          "fileName",
          "contentType"
        ],
        "properties": {
          "documentId": {
            "type": "string"
          },
          "downloadUrl": {
            "type": "string",
            "format": "uri"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "fileName": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          }
        }
      },
      "DocumentListEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "success",
          "data",
          "meta"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "data": {
            "$ref": "#/components/schemas/DocumentList"
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          }
        }
      },
      "DocumentEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "success",
          "data",
          "meta"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "data": {
            "$ref": "#/components/schemas/Document"
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          }
        }
      },
      "DocumentDownloadEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "success",
          "data",
          "meta"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "data": {
            "$ref": "#/components/schemas/DocumentDownload"
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          }
        }
      }
    }
  }
}
