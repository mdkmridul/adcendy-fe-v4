server {
    listen 8080;
    server_name ${PUBLIC_HOST};

    # Backend probes are for private Infrastructure access only.
    location = /v1/health/live { return 404; }
    location = /v1/health/ready { return 404; }

    location ~ ^/(v1|api/v2)/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_next_upstream off;
        proxy_buffering off;
        proxy_request_buffering on;

        proxy_set_header Host $host;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Proto ${PUBLIC_SCHEME};
        proxy_set_header X-Forwarded-Host ${PUBLIC_HOST};
        proxy_set_header X-Forwarded-For $http_cf_connecting_ip;

        proxy_set_header Authorization $http_authorization;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Origin $http_origin;
        proxy_set_header Referer $http_referer;
        proxy_set_header Idempotency-Key $http_idempotency_key;
        proxy_set_header X-Request-Id $http_x_request_id;

        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 300s;

        add_header X-Accel-Buffering "no" always;
    }

    location / {
        proxy_pass ${FRONTEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_next_upstream off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto ${PUBLIC_SCHEME};
        proxy_set_header X-Forwarded-Host ${PUBLIC_HOST};
        proxy_set_header X-Forwarded-For $http_cf_connecting_ip;
    }
}
